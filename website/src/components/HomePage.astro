---
import DynamicOsdDemo from "./DynamicOsdDemo.astro";
import InputVolumeDemo from "./InputVolumeDemo.astro";
import { SITE } from "../data/site";

interface Props {
  locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const content = {
  zh: {
    badge: "macOS 菜单栏音量工具",
    headline: "Rolume",
    subheadline: "滚一下，音量就到位",
    intro: "用鼠标滚轮、触控板滑动或修饰键，快速调节 Mac 当前声音输出。轻量、开源，不打扰。",
    primaryCta: `下载 Rolume ${SITE.version}`,
    secondaryCta: "查看源码",
    unsignedNote: "当前公开测试版尚未签名。首次运行时，macOS 可能需要你手动确认打开。",
    demo: {
      desktopTitle: "把光标放进这个窗口",
      desktopCopy: "滚动或双指滑动",
      touchTitle: "轻点这个窗口",
      touchCopy: "然后上下滑动试用",
      touchActiveTitle: "上下滑动调节音量",
      touchActiveCopy: "点到窗口外即可继续滚动页面",
    },
    device: {
      kicker: "声音输出",
      title: "支持你正在使用的设备",
      body: "Rolume 跟随 macOS 当前输出；显示器可用时通过 DDC/CI 控制。",
      outputs: [
        ["外接显示器", "支持 DDC/CI 时可直接控制显示器扬声器。", "/device-icons/display.svg", "DDC/CI"],
        ["MacBook", "跟随当前系统输出，内置扬声器也能顺手调。", "/device-icons/macbook.svg", "系统输出"],
        ["耳机 / AirPods", "切到耳机后，滚动手感保持一致。", "/device-icons/airpods.svg", "当前输出"],
        ["AirPlay", "作为当前声音输出时，同样用 Rolume 调节。", "/device-icons/airplay.svg", "AirPlay"],
      ],
    },
    settings: {
      kicker: "设置",
      title: "该调的地方，都在这里",
      body: "显示器音量、滚动步进、触发区域和鼠标反转。设好一次，平时就留在菜单栏。",
      beforeStrong: "通用页处理输出设备，鼠标页处理滚动手感。",
      strong: "单独反转鼠标滚轮方向",
      afterStrong: "也在这里，不必再为这一个习惯额外装一款工具。",
      generalAlt: "Rolume 通用设置窗口，显示 R27U81 外接显示器音量和常用开关。",
      mouseAlt: "Rolume 鼠标设置窗口，显示步进幅度、滚动调节音量和滚轮反转选项。",
      points: [
        ["显示器音量", "独立滑块和设备名称"],
        ["鼠标 / 触控板分开", "区域、步进和修饰键互不影响"],
        ["鼠标滚轮单独反转", "不影响触控板；可排除特定 App。"],
      ],
    },
    osd: {
      kicker: "反馈",
      title: "滚动时，只提示结果",
      body: "OSD 显示设备名和音量条，短暂出现，然后回到你的工作里。",
    },
    download: {
      kicker: "下载",
      title: "从 GitHub Releases 获取",
      body: "开源发布，安装包和更新记录都放在 GitHub。需要滚轮反转或拦截滚动时，再按需开启辅助功能权限。",
      button: "下载 DMG",
      releases: "所有版本",
    },
  },
  en: {
    badge: "macOS menu bar volume utility",
    headline: "Rolume",
    subheadline: "Scroll once. Volume follows.",
    intro: "Adjust the current Mac audio output with a mouse wheel, trackpad gesture, or modifier key. Lightweight, open source, and out of your way.",
    primaryCta: `Download Rolume ${SITE.version}`,
    secondaryCta: "View source",
    unsignedNote: "This public beta is not signed yet. On first launch, macOS may ask you to confirm opening the app manually.",
    demo: {
      desktopTitle: "Move your pointer here",
      desktopCopy: "Scroll or use a two-finger gesture",
      touchTitle: "Tap this preview",
      touchCopy: "Then swipe up or down",
      touchActiveTitle: "Swipe to adjust volume",
      touchActiveCopy: "Tap outside to scroll the page again",
    },
    device: {
      kicker: "Audio output",
      title: "Works with the device you are using",
      body: "Rolume follows the current macOS output. External displays can be controlled through DDC/CI when available.",
      outputs: [
        ["External display", "Control display speakers directly when DDC/CI is available.", "/device-icons/display.svg", "DDC/CI"],
        ["MacBook", "Works with the built-in speakers when they are the current output.", "/device-icons/macbook.svg", "System output"],
        ["Headphones / AirPods", "Keep the same scrolling feel after switching to headphones.", "/device-icons/airpods.svg", "Current output"],
        ["AirPlay", "When AirPlay is the active output, Rolume follows it too.", "/device-icons/airplay.svg", "AirPlay"],
      ],
    },
    settings: {
      kicker: "Settings",
      title: "The useful controls, in one place",
      body: "Display volume, scroll steps, trigger areas, and mouse reversal. Set it once, then leave Rolume in the menu bar.",
      beforeStrong: "General settings handle outputs; Mouse settings handle scrolling feel. ",
      strong: "Mouse wheel reversal",
      afterStrong: " is built in, so you do not need another utility just for that habit.",
      generalAlt: "Rolume General settings window showing R27U81 external display volume and common toggles.",
      mouseAlt: "Rolume Mouse settings window showing step size, scroll-to-volume options, and mouse wheel reversal.",
      points: [
        ["Display volume", "Separate slider and device name"],
        ["Mouse / trackpad split", "Areas, steps, and modifier keys stay independent"],
        ["Mouse-only reversal", "Reverse only the mouse; exclude specific apps."],
      ],
    },
    osd: {
      kicker: "Feedback",
      title: "Only the result appears",
      body: "The OSD shows the device name and volume bar, then quickly gets out of the way.",
    },
    download: {
      kicker: "Download",
      title: "Get it from GitHub Releases",
      body: "Rolume is open source. Builds and release notes live on GitHub. Accessibility permission is only needed for reversal or scroll interception.",
      button: "Download DMG",
      releases: "All releases",
    },
  },
};

const copy = content[locale];
---

<section class="hero-scene overflow-hidden border-b border-[color:var(--line)]" data-hero-scene>
  <div class="hero-cursor-light" aria-hidden="true"></div>
  <div class="hero-desktop mx-auto grid min-h-[78svh] max-w-6xl items-center gap-10 px-5 py-16 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="hero-copy min-w-0 max-w-2xl">
      <p class="hero-badge mb-5 inline-flex rounded-[8px] border border-[color:var(--line)] bg-white/70 px-3 py-1 text-sm font-medium text-[color:var(--muted)]">
        {copy.badge}
      </p>
      <h1 class="max-w-4xl text-5xl font-semibold leading-[0.98] tracking-normal text-[color:var(--ink)] sm:text-7xl">
        {copy.headline}
      </h1>
      <h2 class="mt-5 max-w-3xl text-3xl font-semibold leading-tight tracking-normal text-[color:var(--ink)] sm:text-4xl">
        {copy.subheadline}
      </h2>
      <p class="mt-5 max-w-2xl text-xl leading-8 text-[color:var(--muted)]">
        {copy.intro}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          class="primary-button inline-flex min-h-12 items-center justify-center rounded-[8px] bg-[color:var(--ink)] px-5 py-3 text-sm font-semibold text-white transition hover:bg-black"
          href={SITE.downloadUrl}
        >
          {copy.primaryCta}
        </a>
        <a
          class="secondary-button inline-flex min-h-12 items-center justify-center rounded-[8px] border border-[color:var(--line)] bg-white/78 px-5 py-3 text-sm font-semibold text-[color:var(--ink)] transition hover:bg-white"
          href={SITE.repositoryUrl}
        >
          {copy.secondaryCta}
        </a>
      </div>
      <p class="mt-5 text-sm leading-6 text-[color:var(--muted)]">
        {copy.unsignedNote}
      </p>
    </div>
    <div class="hero-demo-wrap min-w-0 lg:justify-self-end">
      <InputVolumeDemo {...copy.demo} />
    </div>
  </div>
</section>

<section class="device-section border-b border-[color:var(--line)]">
  <div class="device-stage mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-[0.72fr_1.28fr]">
    <div class="device-copy max-w-xl">
      <p class="text-sm font-semibold tracking-normal text-[color:var(--blue)]">{copy.device.kicker}</p>
      <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-normal text-[color:var(--ink)] sm:text-4xl">
        {copy.device.title}
      </h2>
      <p class="mt-4 max-w-2xl leading-7 text-[color:var(--muted)]">
        {copy.device.body}
      </p>
    </div>
    <div class="device-grid grid gap-4 sm:grid-cols-2">
      {
        copy.device.outputs.map(([title, description, icon, tag]) => (
          <article class="device-card group transition duration-200 hover:-translate-y-1 hover:shadow-[0_24px_48px_rgba(18,20,23,0.12)]">
            <span class="device-icon-wrap">
              <img class="device-icon" src={withBase(icon)} alt="" loading="lazy" decoding="async" />
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-base font-semibold tracking-normal text-[color:var(--ink)]">{title}</h3>
                <span class="device-tag">{tag}</span>
              </div>
              <p class="mt-2 text-sm leading-6 text-[color:var(--muted)]">{description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="story-section mx-auto max-w-6xl px-5 py-16">
  <div class="product-showcase">
    <div class="screenshot-stack" aria-label="Rolume settings window screenshots">
      <figure class="stacked-shot stacked-shot-general">
        <img src={withBase("/screenshots/general-settings.png")} alt={copy.settings.generalAlt} loading="eager" decoding="async" />
      </figure>
      <figure class="stacked-shot stacked-shot-mouse">
        <img src={withBase("/screenshots/mouse-settings.png")} alt={copy.settings.mouseAlt} loading="eager" decoding="async" />
      </figure>
    </div>

    <div class="showcase-copy">
      <p class="text-sm font-semibold tracking-normal text-[color:var(--green)]">{copy.settings.kicker}</p>
      <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-normal text-[color:var(--ink)] sm:text-4xl">
        {copy.settings.title}
      </h2>
      <p class="mt-4 leading-7 text-[color:var(--muted)]">
        {copy.settings.body}
      </p>
      <p class="mt-3 leading-7 text-[color:var(--muted)]">
        {copy.settings.beforeStrong}<strong class="font-semibold text-[color:var(--ink)]">{copy.settings.strong}</strong>{copy.settings.afterStrong}
      </p>
      <div class="settings-points mt-7 grid gap-3">
        {
          copy.settings.points.map(([title, description]) => (
            <div class="settings-point">
              <p class="text-sm font-semibold text-[color:var(--ink)]">{title}</p>
              <p class="mt-1 text-sm leading-6 text-[color:var(--muted)]">{description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="osd-showcase">
    <DynamicOsdDemo />
    <div class="osd-copy">
      <p class="text-sm font-semibold tracking-normal text-[color:var(--orange)]">{copy.osd.kicker}</p>
      <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-normal text-[color:var(--ink)] sm:text-4xl">
        {copy.osd.title}
      </h2>
      <p class="mt-4 leading-7 text-[color:var(--muted)]">
        {copy.osd.body}
      </p>
    </div>
  </div>
</section>

<section class="download-section border-t border-[color:var(--line)]">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 lg:grid-cols-[1fr_1fr]">
    <div>
      <p class="text-sm font-semibold tracking-normal text-[color:var(--blue)]">{copy.download.kicker}</p>
      <h2 class="mt-3 text-3xl font-semibold leading-tight tracking-normal text-[color:var(--ink)]">
        {copy.download.title}
      </h2>
      <p class="mt-4 leading-7 text-[color:var(--muted)]">
        {copy.download.body}
      </p>
    </div>
    <div class="feature-card min-w-0 p-6">
      <p class="text-sm font-semibold text-[color:var(--muted)]">SHA-256</p>
      <code class="mt-3 block max-w-full overflow-x-auto whitespace-nowrap rounded-[8px] bg-[color:var(--surface-muted)] p-3 text-sm text-[color:var(--ink)]">{SITE.sha256}</code>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a class="inline-flex min-h-11 items-center justify-center rounded-[8px] bg-[color:var(--blue)] px-4 py-2 text-sm font-semibold text-white" href={SITE.downloadUrl}>
          {copy.download.button}
        </a>
        <a class="inline-flex min-h-11 items-center justify-center rounded-[8px] border border-[color:var(--line)] px-4 py-2 text-sm font-semibold" href={SITE.releasesUrl}>
          {copy.download.releases}
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const scene = document.querySelector("[data-hero-scene]");
    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!scene || !canHover || reduceMotion) return;

    let pointerX = 70;
    let pointerY = 42;
    let raf = 0;

    const render = () => {
      raf = 0;
      scene.style.setProperty("--hero-pointer-x", `${pointerX}%`);
      scene.style.setProperty("--hero-pointer-y", `${pointerY}%`);
    };

    scene.addEventListener(
      "pointermove",
      (event) => {
        const rect = scene.getBoundingClientRect();
        pointerX = ((event.clientX - rect.left) / rect.width) * 100;
        pointerY = ((event.clientY - rect.top) / rect.height) * 100;
        if (!raf) raf = window.requestAnimationFrame(render);
      },
      { passive: true },
    );
  })();
</script>

<style>
  .hero-scene {
    --hero-pointer-x: 68%;
    --hero-pointer-y: 42%;
    position: relative;
    isolation: isolate;
    background:
      radial-gradient(circle at 78% 22%, rgba(14, 165, 233, 0.18), transparent 30%),
      radial-gradient(circle at 88% 72%, rgba(244, 114, 182, 0.16), transparent 26%),
      radial-gradient(circle at 18% 18%, rgba(255, 255, 255, 0.92), transparent 34%),
      linear-gradient(180deg, rgba(245, 248, 252, 0.97), rgba(231, 237, 246, 0.92));
  }

  .hero-scene::before {
    content: "";
    position: absolute;
    inset: 18px max(18px, calc((100vw - 1160px) / 2)) 28px;
    z-index: 0;
    border: 1px solid rgba(255, 255, 255, 0.68);
    border-radius: 30px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.2)),
      rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.74),
      0 48px 120px rgba(36, 48, 68, 0.14);
    -webkit-backdrop-filter: blur(28px) saturate(1.2);
    backdrop-filter: blur(28px) saturate(1.2);
  }

  .hero-scene::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 112px;
    z-index: 0;
    background:
      linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.72)),
      radial-gradient(ellipse at center, rgba(255, 255, 255, 0.56), transparent 70%);
    pointer-events: none;
  }

  .hero-cursor-light {
    position: absolute;
    left: var(--hero-pointer-x);
    top: var(--hero-pointer-y);
    width: min(46vw, 520px);
    aspect-ratio: 1;
    z-index: 0;
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.22) 35%, transparent 68%),
      radial-gradient(circle, rgba(59, 130, 246, 0.18), transparent 68%);
    filter: blur(10px);
    opacity: 0.72;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: opacity 180ms ease;
  }

  .hero-desktop {
    position: relative;
    z-index: 1;
  }

  .hero-copy {
    padding-block: clamp(10px, 3vw, 34px);
  }

  .hero-badge,
  .secondary-button {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.82),
      0 12px 28px rgba(18, 20, 23, 0.05);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .primary-button {
    box-shadow:
      0 16px 28px rgba(18, 20, 23, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .hero-demo-wrap {
    display: flex;
    justify-content: center;
  }

  .device-section {
    position: relative;
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.82), transparent 30%),
      radial-gradient(circle at 88% 36%, rgba(148, 163, 184, 0.16), transparent 28%),
      linear-gradient(180deg, rgba(248, 250, 252, 0.98), rgba(239, 244, 250, 0.94));
  }

  .device-stage {
    align-items: start;
  }

  .device-copy {
    padding-top: 4px;
  }

  .device-grid {
    position: relative;
  }

  .device-grid::before {
    content: "";
    position: absolute;
    inset: -16px;
    z-index: 0;
    border-radius: 24px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.12)),
      rgba(218, 226, 238, 0.22);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    backdrop-filter: blur(18px) saturate(1.1);
  }

  .device-card {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 62px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    min-height: 142px;
    border: 1px solid rgba(194, 204, 219, 0.82);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(255, 255, 255, 0.58)),
      rgba(255, 255, 255, 0.62);
    padding: 22px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.86),
      0 14px 30px rgba(18, 20, 23, 0.06);
    -webkit-backdrop-filter: blur(18px) saturate(1.18);
    backdrop-filter: blur(18px) saturate(1.18);
  }

  .device-icon-wrap {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 1px solid rgba(198, 208, 223, 0.88);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(243, 247, 252, 0.82));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.92),
      0 12px 22px rgba(18, 20, 23, 0.07);
  }

  .device-icon {
    display: block;
    max-width: 35px;
    max-height: 34px;
  }

  .device-tag {
    display: inline-flex;
    align-items: center;
    min-height: 22px;
    border: 1px solid rgba(216, 222, 231, 0.9);
    border-radius: 7px;
    background: rgba(239, 243, 248, 0.74);
    padding: 0 7px;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 760;
    line-height: 1;
  }

  .story-section {
    position: relative;
    isolation: isolate;
  }

  .story-section::before {
    content: "";
    position: absolute;
    inset: 32px 5px auto;
    height: 54%;
    z-index: -1;
    border-radius: 30px;
    background:
      radial-gradient(circle at 18% 36%, rgba(37, 99, 235, 0.09), transparent 28%),
      radial-gradient(circle at 82% 42%, rgba(22, 131, 90, 0.08), transparent 30%);
    pointer-events: none;
  }

  .product-showcase {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(320px, 1.02fr);
    align-items: center;
    gap: clamp(42px, 7vw, 96px);
  }

  .screenshot-stack {
    position: relative;
    min-height: clamp(390px, 43vw, 540px);
    perspective: 900px;
  }

  .screenshot-stack::before {
    content: "";
    position: absolute;
    inset: 8% 6% 10%;
    border-radius: 30px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.18)),
      rgba(225, 232, 242, 0.46);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 42px 74px rgba(26, 35, 48, 0.12);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  .screenshot-stack::after {
    content: "";
    position: absolute;
    right: 13%;
    bottom: 2%;
    left: 9%;
    height: 70px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.16);
    filter: blur(26px);
    opacity: 0.48;
    pointer-events: none;
  }

  .stacked-shot {
    position: absolute;
    margin: 0;
    width: min(55%, 306px);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .stacked-shot img {
    display: block;
    width: 100%;
    height: auto;
    filter:
      drop-shadow(0 28px 38px rgba(18, 20, 23, 0.22))
      drop-shadow(0 10px 16px rgba(18, 20, 23, 0.13));
    transition:
      filter 180ms ease,
      transform 180ms ease;
    will-change: transform;
  }

  .stacked-shot:hover img {
    filter:
      drop-shadow(0 34px 46px rgba(18, 20, 23, 0.25))
      drop-shadow(0 13px 19px rgba(18, 20, 23, 0.15));
    transform: translateY(-6px) scale(1.018);
  }

  .stacked-shot-general {
    top: 5%;
    left: 4%;
    z-index: 1;
    transform: rotate(-8deg) translateY(8px);
  }

  .stacked-shot-mouse {
    right: 8%;
    bottom: 3%;
    z-index: 2;
    transform: rotate(7deg) translateY(-2px);
  }

  .screenshot-stack:hover .stacked-shot-general {
    transform: rotate(-9deg) translate(-6px, 0);
  }

  .screenshot-stack:hover .stacked-shot-mouse {
    transform: rotate(8deg) translate(6px, -8px);
  }

  .showcase-copy {
    max-width: 520px;
  }

  .settings-points {
    grid-template-columns: 1fr;
